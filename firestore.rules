rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is a member of the group
    function isGroupMember(groupId) {
      return request.auth != null && 
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Groups collection
    match /groups/{groupId} {
      // Any authenticated user who is a member can read the group document
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      
      // Any authenticated user can create a group
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberUids;
      
      // Existing members can update group (e.g. inviting new members)
      allow update: if request.auth != null && request.auth.uid in resource.data.memberUids;
      
      // Only owner can delete
      allow delete: if request.auth != null && resource.data.createdBy == request.auth.uid;

      // Group Notes subcollection
      match /notes/{noteId} {
        // Anyone in the group can read public notes; private notes only visible to their author
        allow read: if isGroupMember(groupId) && 
          (!resource.data.isPrivate || resource.data.authorId == request.auth.uid);
        
        // Members can create notes authored by themselves
        allow create: if isGroupMember(groupId) && 
          request.resource.data.authorId == request.auth.uid;
        
        // Only author can update or delete their note
        allow update, delete: if isGroupMember(groupId) && 
          resource.data.authorId == request.auth.uid;
      }

      // Group Meta (cached AI synthesis)
      match /meta/{metaDoc} {
        allow read, write: if isGroupMember(groupId);
      }
    }
  }
}
